<UserControl x:Class="DMHelper.App.Views.CombatTrackerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewmodels="clr-namespace:DMHelper.App.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance Type=viewmodels:CombatTrackerViewModel}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ListView ItemsSource="{Binding Combatants}" SelectedItem="{Binding SelectedCombatant}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Name" DisplayMemberBinding="{Binding Name}" Width="150"/>
                    <GridViewColumn Header="HP" DisplayMemberBinding="{Binding HitPoints}" Width="80"/>
                    <GridViewColumn Header="Init" DisplayMemberBinding="{Binding Initiative}" Width="80"/>
                    <GridViewColumn Header="Current" DisplayMemberBinding="{Binding IsCurrentTurn}" Width="80"/>
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="0,10,0,0">
            <Button Content="Add" Command="{Binding AddCombatantCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,10,0"/>
            <Button Content="Remove" Command="{Binding RemoveCombatantCommand}" Style="{StaticResource DangerButtonStyle}" Margin="0,0,10,0"/>
            <Button Content="Start" Command="{Binding StartEncounterCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,10,0"/>
            <Button Content="Next" Command="{Binding NextTurnCommand}" Style="{StaticResource PrimaryButtonStyle}"/>
        </StackPanel>
    </Grid>
</UserControl>
